isThread":false},"moduleMetadata":{"moduleName":"wenglor_api"},"reference":{"id":"ad441eb2-451c-f539-6408-77d856d00a98","_IDENTIFIER":"FunctionReference"}},{"name":"detect_target","programNodeMetadata":{"programNodeId":"6e9dc963-83ec-9dfe-87f7-bb83383bf6e0","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_api"},"reference":{"id":"be77e547-e6e3-79b6-9a6a-c693a5cfea91","_IDENTIFIER":"FunctionReference"}},{"name":"calibrate_to_target","programNodeMetadata":{"programNodeId":"c51095ec-377f-baa5-e6ee-9dc49e3b34c7","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_api"},"reference":{"id":"ce9bcaa0-4258-3d0b-16f7-43e8b2e1dc1b","_IDENTIFIER":"FunctionReference"}},{"name":"connect_with_vision_device","programNodeMetadata":{"programNodeId":"411cda2d-eb56-8095-097b-c3f5197e9208","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"543b5420-d96e-3a29-2afd-7265938e0544","_IDENTIFIER":"FunctionReference"}},{"name":"send_command","programNodeMetadata":{"programNodeId":"d4289721-66c1-f4c2-32c1-eb8a54f214fa","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"fe134d74-a3d5-9774-3900-43c430ebfeb2","_IDENTIFIER":"FunctionReference"}},{"name":"receive_response","programNodeMetadata":{"programNodeId":"7abb8fd0-f741-4096-0f79-e401b3d62664","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"8951fcba-0234-895a-6e05-aee06ce6b419","_IDENTIFIER":"FunctionReference"}},{"name":"send_and_read_string","programNodeMetadata":{"programNodeId":"d280c6af-18d7-ef22-4e02-a0f8b34e7731","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"22635519-2bf9-5212-0c1d-53e31e7630e9","_IDENTIFIER":"FunctionReference"}},{"name":"change_job","programNodeMetadata":{"programNodeId":"5bf96a98-dbc8-9a33-5d8f-b82445aeee09","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"ec010776-3310-221b-9075-12e21ecf7d62","_IDENTIFIER":"FunctionReference"}},{"name":"check_camera_reply","programNodeMetadata":{"programNodeId":"473fbfbe-7771-b904-a530-bd45681278b2","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"e91eaeff-46ca-cf8c-1dad-0c98a7581dc5","_IDENTIFIER":"FunctionReference"}},{"name":"set_return_error","programNodeMetadata":{"programNodeId":"87e8100b-727c-e0c2-d96b-7005e6927e5b","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"77b51460-db4f-46f9-6247-e9d336f0f418","_IDENTIFIER":"FunctionReference"}},{"name":"are_calibration_poses_set","programNodeMetadata":{"programNodeId":"689947b8-11b8-6d2a-89f2-ae6614d0822a","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"8d206486-6965-c937-a7cd-1418cea0cded","_IDENTIFIER":"FunctionReference"}},{"name":"update_tcp_pose_string","programNodeMetadata":{"programNodeId":"cace968f-3402-24a1-3b6d-6a1f2f6f84d3","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"7ccf9544-61ea-4e8d-0c9c-d8cc48e903c6","_IDENTIFIER":"FunctionReference"}},{"name":"string_to_pose","programNodeMetadata":{"programNodeId":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"c2d4d363-eb31-3c29-5799-d0eb0af2de78","_IDENTIFIER":"FunctionReference"}},{"name":"calibrate_if_needed","programNodeMetadata":{"programNodeId":"3dad3c39-d37a-cfc5-db0d-d09538f548f6","isSuppressed":false,"isThread":false},"moduleMetadata":{"moduleName":"wenglor_helpers"},"reference":{"id":"3c51b7c8-d7df-6d87-14e8-a6e388f3208f","_IDENTIFIER":"FunctionReference"}}],"modules":[{"name":"wenglor_examples","programNodeMetadata":{"programNodeId":"6f24782b-dea4-66ce-33e0-b4377bcfbd83","isSuppressed":false},"reference":{"id":"ec224905-dcc6-18d6-df10-3e14647247ef","_IDENTIFIER":"ModuleReference"}},{"name":"wenglor_api","programNodeMetadata":{"programNodeId":"d8b1be8a-2b86-5401-59e5-9843c920fc19","isSuppressed":false},"reference":{"id":"50821415-05d5-8170-2c31-15442ebc2460","_IDENTIFIER":"ModuleReference"}},{"name":"wenglor_helpers","programNodeMetadata":{"programNodeId":"31f3b476-fd63-184e-2751-a050215d93e8","isSuppressed":false},"reference":{"id":"cfb9c017-9ba5-7110-15a2-77afb75b7717","_IDENTIFIER":"ModuleReference"}},{"name":"application","reference":{"id":"application-module-id","_IDENTIFIER":"ModuleReference"}}]}}},"guid":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651"},"programInformation":{"name":"Generic wenglor interface","description":null,"createdDate":1782392170472,"lastSavedDate":1782455091563,"lastModifiedDate":null,"programState":"FINAL","functionsBlockShown":false},"urscript":{"script":"$ 1 \"ur-program\"\n$ 2 \"ur-modules\"\n$ 3 \"ur-module\"\n$ 4 \"ur-function\"\ndef wenglor_examples_single_detection():\n  $ 5 \"ur-comment\"\n  $ 6 \"ur-if\"\n  if (to_str(g_detection_pose) == to_str(WIG_EMPTY_POSE)):\n    $ 7 \"ur-operator-input\"\n    popup(\"Exit program as g_detection_pose pose is not set\", \"error\", False, True, blocking=True)\n    $ 8 \"ur-halt\"\n    halt\n  end\n  $ 9 \"ur-call-function\"\n  wenglor_helpers_calibrate_if_needed()\n  $ 10 \"ur-call-function\"\n  wenglor_api_load_find_object_job()\n  $ 11 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n  $ 12 \"ur-assignment\"\n  wg_object_index = 0\n  $ 13 \"ur-comment\"\n  $ 14 \"ur-call-function\"\n  wenglor_api_detect_objects()\n  $ 15 \"ur-call-function\"\n  wenglor_api_read_shape_by_index()\n  $ 16 \"ur-comment\"\n  $ 17 \"ur-comment\"\n  $ 18 \"ur-linear-move\"\n  optimovel(wg_object_pose, a=0.04, v=0.2)\nend\n$ 19 \"ur-function\"\ndef wenglor_examples_multi_detection():\n  $ 20 \"ur-comment\"\n  $ 21 \"ur-if\"\n  if (to_str(g_detection_pose) == to_str(WIG_EMPTY_POSE)):\n    $ 22 \"ur-operator-input\"\n    popup(\"Exit program as g_detection_pose pose is not set\", \"error\", False, True, blocking=True)\n    $ 23 \"ur-halt\"\n    halt\n  end\n  $ 24 \"ur-call-function\"\n  wenglor_helpers_calibrate_if_needed()\n  $ 25 \"ur-call-function\"\n  wenglor_api_load_find_object_job()\n  $ 26 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n  $ 27 \"ur-assignment\"\n  wg_object_index = 0\n  $ 28 \"ur-comment\"\n  $ 29 \"ur-call-function\"\n  wenglor_api_detect_objects()\n  $ 30 \"ur-call-function\"\n  wenglor_api_read_num_objects()\n  $ 31 \"ur-loop\"\n  while (wg_object_index < wg_num_objects_found):\n    $ 32 \"ur-comment\"\n    $ 33 \"ur-call-function\"\n    wenglor_api_read_pose_by_index()\n    $ 34 \"ur-call-function\"\n    wenglor_api_read_shape_by_index()\n    $ 35 \"ur-comment\"\n    $ 36 \"ur-comment\"\n    $ 37 \"ur-linear-move\"\n    optimovel(wg_object_pose, a=0.04, v=0.2)\n    $ 38 \"ur-assignment\"\n    wg_object_index = wg_object_index + 1\n  end\nend\n$ 39 \"ur-function\"\ndef wenglor_examples_update_reference_frame():\n  $ 40 \"ur-call-function\"\n  wenglor_helpers_calibrate_if_needed()\n  $ 41 \"ur-call-function\"\n  wenglor_api_load_find_target_job()\n  $ 42 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n  $ 43 \"ur-call-function\"\n  wenglor_api_detect_target()\n  $ 44 \"ur-frame\"\n  add_frame(\"w_ref_frame\", wg_target_pose, \"world\")\n  attach_frame(\"w_ref_frame\", \"world\")\n  $ 45 \"ur-if\"\n  if (WG_MACHINE_POSES_TAUGHT==False ):\n    $ 46 \"ur-operator-input\"\n    popup(\"Reference frame updated. Please teach poses now relative to w_reference_frame\", \"info\", False, False, blocking=True)\n    $ 47 \"ur-operator-input\"\n    popup(\"Set WG_MACHINE_POSES_TAUGHT to TRUE and restart program after teaching the poses.\", \"info\", False, False, blocking=True)\n    $ 48 \"ur-halt\"\n    halt\n  end\n  $ 49 \"ur-comment\"\n  $ 50 \"ur-comment\"\n  $ 51 \"ur-linear-move\"\n  optimovel(convert_pose(G_POSE_IN_MACHINE.p, G_POSE_IN_MACHINE.frame, \"base\"), a=0.04, v=0.2)\nend\n$ 52 \"ur-module\"\n$ 53 \"ur-function\"\ndef wenglor_api_load_calibration_job():\n  $ 54 \"ur-assignment\"\n  wig_job_name = WG_CALIB_JOB\n  $ 55 \"ur-call-function\"\n  wenglor_helpers_change_job()\nend\n$ 56 \"ur-function\"\ndef wenglor_api_load_find_object_job():\n  $ 57 \"ur-assignment\"\n  wig_job_name = WG_FIND_OBJECTS_JOB\n  $ 58 \"ur-call-function\"\n  wenglor_helpers_change_job()\nend\n$ 59 \"ur-function\"\ndef wenglor_api_load_find_target_job():\n  $ 60 \"ur-assignment\"\n  wig_job_name = WG_FIND_TARGET_JOB\n  $ 61 \"ur-call-function\"\n  wenglor_helpers_change_job()\nend\n$ 62 \"ur-function\"\ndef wenglor_api_update_camera_status():\n  $ 63 \"ur-assignment\"\n  wig_command = \"state[\" + WG_USE_CASE +  \"];\"\n  $ 64 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 65 \"ur-if\"\n  if (str_at(wig_camera_reply,0) != \"0\"):\n    $ 66 \"ur-operator-input\"\n    popup(\"Camera error. Please check the device websites tab Jobs\", \"error\", False, True, blocking=True)\n    $ 67 \"ur-halt\"\n    halt\n  end\n  $ 68 \"ur-if\"\n  if (str_at(wig_camera_reply,1) == \"0\"):\n    $ 69 \"ur-assignment\"\n    wig_calibration_done = False\n  $ 70 \"ur-elseif\"\n  elif (str_at(wig_camera_reply,1) == \"1\"):\n    $ 71 \"ur-assignment\"\n    wig_calibration_done = True\n  $ 72 \"ur-else\"\n  else:\n    $ 73 \"ur-assignment\"\n    wig_calibration_done = False\n    $ 74 \"ur-script\"\n    textmsg(s1=\"Unknown calibration state: \" + str_at(wig_camera_reply,1),s2=\"\")\n  end\nend\n$ 75 \"ur-function\"\ndef wenglor_api_clear_calibration_buffer():\n  $ 76 \"ur-assignment\"\n  wig_command = \"calibration:clear;\"\n  $ 77 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\nend\n$ 78 \"ur-function\"\ndef wenglor_api_add_calibration_pose():\n  $ 79 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 80 \"ur-wait\"\n  sleep(0.5)\n  $ 81 \"ur-call-function\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 82 \"ur-assignment\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\nend\n$ 83 \"ur-function\"\ndef wenglor_api_run_calibration():\n  $ 84 \"ur-call-function\"\n  wenglor_helpers_are_calibration_poses_set()\n  $ 85 \"ur-if\"\n  if (wig_poses_set == False):\n    $ 86 \"ur-operator-input\"\n    popup(\"Exit program as calibration poses are not set.\", \"error\", False, True, blocking=True)\n    $ 87 \"ur-halt\"\n    halt\n  end\n  $ 88 \"ur-call-function\"\n  wenglor_api_update_camera_status()\n  $ 89 \"ur-if\"\n  if (wig_calibration_done == True):\n    $ 90 \"ur-operator-input\"\n    global answer = request_boolean_from_primary_client(\"Calibration already done. Redo?\")\n    $ 91 \"ur-if\"\n    if (answer == False):\n      $ 92 \"ur-script\"\n      return None\n    end\n  end\n  $ 93 \"ur-comment\"\n  $ 94 \"ur-call-function\"\n  wenglor_api_clear_calibration_buffer()\n  $ 95 \"ur-call-function\"\n  wenglor_api_load_calibration_job()\n  $ 96 \"ur-if\"\n  if (WG_USE_CASE == \"camera_not_on_robot\"):\n    $ 97 \"ur-operator-input\"\n    popup(\"Confirm when calibration board was mounted and correct tool is selected.\", \"info\", False, False, blocking=True)\n  $ 98 \"ur-elseif\"\n  elif (WG_USE_CASE == \"camera_on_robot\"):\n    $ 99 \"ur-operator-input\"\n    popup(\"Confirm when calibration board was placed and correct tool is selected.\", \"info\", False, False, blocking=True)\n  $ 100 \"ur-else\"\n  else:\n    $ 101 \"ur-operator-input\"\n    popup(\"Unknown use case. Program was aborted.\", \"error\", False, True, blocking=True)\n    $ 102 \"ur-halt\"\n    halt\n  end\n  $ 103 \"ur-folder\"\n  $ 104 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(WG_CALIB_POSE_1.p, WG_CALIB_POSE_1.frame, \"base\"), qnear=WG_CALIB_POSE_1.q), a=0.09, v=0.3)\n  $ 105 \"ur-call-function\"\n  wenglor_api_add_calibration_pose()\n  $ 106 \"ur-folder\"\n  $ 107 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(WG_CALIB_POSE_2.p, WG_CALIB_POSE_2.frame, \"base\"), qnear=WG_CALIB_POSE_2.q), a=0.09, v=0.3)\n  $ 108 \"ur-call-function\"\n  wenglor_api_add_calibration_pose()\n  $ 109 \"ur-folder\"\n  $ 110 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(WG_CALIB_POSE_3.p, WG_CALIB_POSE_3.frame, \"base\"), qnear=WG_CALIB_POSE_3.q), a=0.09, v=0.3)\n  $ 111 \"ur-call-function\"\n  wenglor_api_add_calibration_pose()\n  $ 112 \"ur-folder\"\n  $ 113 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(WG_CALIB_POSE_4.p, WG_CALIB_POSE_4.frame, \"base\"), qnear=WG_CALIB_POSE_4.q), a=0.09, v=0.3)\n  $ 114 \"ur-call-function\"\n  wenglor_api_add_calibration_pose()\n  $ 115 \"ur-folder\"\n  $ 116 \"ur-move-to\"\n  optimovej(get_inverse_kin(convert_pose(WG_CALIB_POSE_5.p, WG_CALIB_POSE_5.frame, \"base\"), qnear=WG_CALIB_POSE_5.q), a=0.09, v=0.3)\n  $ 117 \"ur-call-function\"\n  wenglor_api_add_calibration_pose()\n  $ 118 \"ur-comment\"\n  $ 119 \"ur-assignment\"\n  wig_command = \"calibration:calculate[\" + WG_USE_CASE + \",\" + WG_CALIBRATION_TARGET + \"];\"\n  $ 120 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 121 \"ur-script\"\n  popup(\"Calibration completed with a reprojection error of \" + wig_camera_reply, \"info\", False, False, blocking=True)\n  $ 122 \"ur-if\"\n  if (WG_USE_CASE == \"camera_on_robot\"):\n    $ 123 \"ur-comment\"\n    $ 124 \"ur-assignment\"\n    g_detection_pose = WG_CALIB_POSE_1\n  $ 125 \"ur-elseif\"\n  elif (WG_USE_CASE == \"camera_not_on_robot\"):\n    $ 126 \"ur-if\"\n    if (to_str(g_detection_pose) == to_str(WIG_EMPTY_POSE)):\n      $ 127 \"ur-operator-input\"\n      popup(\"Exit program as wenglorDetection pose is not set.\", \"error\", False, True, blocking=True)\n      $ 128 \"ur-halt\"\n      halt\n    end\n    $ 129 \"ur-move-to\"\n    optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n    $ 130 \"ur-operator-input\"\n    global user_input = request_boolean_from_primary_client(\"Confirm when the calibration target has been placed on the object plane.\")\n    $ 131 \"ur-if\"\n    if (user_input == True):\n      $ 132 \"ur-assignment\"\n      wig_command = \"calibration:ground[\" + WG_CALIBRATION_TARGET + \"];\"\n      $ 133 \"ur-call-function\"\n      wenglor_helpers_send_and_read_string()\n      $ 134 \"ur-operator-input\"\n      popup(\"Calibration to ground done.\", \"info\", False, False, blocking=True)\n    $ 135 \"ur-else\"\n    else:\n      $ 136 \"ur-operator-input\"\n      popup(\"Calibration to ground aborted\", \"warning\", True, False, blocking=True)\n      $ 137 \"ur-halt\"\n      halt\n    end\n  end\nend\n$ 138 \"ur-function\"\ndef wenglor_api_validate_calibration():\n  $ 139 \"ur-call-function\"\n  wenglor_api_update_camera_status()\n  $ 140 \"ur-if\"\n  if (wig_calibration_done == False ):\n    $ 141 \"ur-operator-input\"\n    popup(\"Calibration is not complete and cannot be validated.\", \"warning\", True, False, blocking=True)\n    $ 142 \"ur-script\"\n    return None\n  $ 143 \"ur-else\"\n  else:\n    $ 144 \"ur-if\"\n    if (to_str(g_detection_pose) == to_str(WIG_EMPTY_POSE)):\n      $ 145 \"ur-operator-input\"\n      popup(\"Detection pose is not set\", \"warning\", True, False, blocking=True)\n      $ 146 \"ur-script\"\n      return None\n    end\n    $ 147 \"ur-operator-input\"\n    answer = request_boolean_from_primary_client(\"Move to detection pose and confirm to validate calibration?\")\n    $ 148 \"ur-if\"\n    if (answer == False ):\n      $ 149 \"ur-operator-input\"\n      popup(\"Calibration validation aborted\", \"info\", False, False, blocking=True)\n      $ 150 \"ur-script\"\n      return None\n    end\n    $ 151 \"ur-move-to\"\n    optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n    $ 152 \"ur-call-function\"\n    wenglor_helpers_update_tcp_pose_string()\n    $ 153 \"ur-assignment\"\n    wig_command = \"validate[\"+ WG_USE_CASE + \",\" + wig_tcp_pose_string + \"];\"\n    $ 154 \"ur-call-function\"\n    wenglor_helpers_send_and_read_string()\n    $ 155 \"ur-call-function\"\n    wenglor_helpers_string_to_pose()\n    $ 156 \"ur-assignment\"\n    global calib_target_pose = pose_trans(wg_object_pose,p[0,0,-WG_VALIDATION_OFFSET_Z_MM/1000,0,0,0])\n    $ 157 \"ur-linear-move\"\n    optimovel(calib_target_pose, a=0.04, v=0.2)\n    $ 158 \"ur-operator-input\"\n    answer = request_boolean_from_primary_client(\"Confirm when calibration result was checked.\")\n  end\nend\n$ 159 \"ur-function\"\ndef wenglor_api_detect_objects():\n  $ 160 \"ur-call-function\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 161 \"ur-comment\"\n  $ 162 \"ur-assignment\"\n  wig_command = \"detect[\"+ WG_USE_CASE + \",\" + wig_tcp_pose_string + \"];\"\n  $ 163 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 164 \"ur-call-function\"\n  wenglor_helpers_string_to_pose()\nend\n$ 165 \"ur-function\"\ndef wenglor_api_read_num_objects():\n  $ 166 \"ur-assignment\"\n  wig_command = \"num_objects:get;\"\n  $ 167 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 168 \"ur-assignment\"\n  wg_num_objects_found = to_num(wig_camera_reply)\nend\n$ 169 \"ur-function\"\ndef wenglor_api_read_pose_by_index():\n  $ 170 \"ur-assignment\"\n  wig_command = \"pose:get[\" + to_str(wg_object_index) +\"];\"\n  $ 171 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 172 \"ur-call-function\"\n  wenglor_helpers_string_to_pose()\nend\n$ 173 \"ur-function\"\ndef wenglor_api_read_shape_by_index():\n  $ 174 \"ur-assignment\"\n  wig_command = \"shape:get[\" + to_str(wg_object_index) +\"];\"\n  $ 175 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 176 \"ur-assignment\"\n  wg_shape_model = to_num(wig_camera_reply)\nend\n$ 177 \"ur-function\"\ndef wenglor_api_real_value_by_index():\n  $ 178 \"ur-assignment\"\n  wig_command = \"value:get[\" + to_str(wg_object_index) +\"];\"\n  $ 179 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 180 \"ur-assignment\"\n  wg_additional_value = wig_camera_reply\nend\n$ 181 \"ur-function\"\ndef wenglor_api_detect_target():\n  $ 182 \"ur-call-function\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 183 \"ur-assignment\"\n  wig_command = \"target:pose[\"+ WG_USE_CASE + \",\" + WG_CALIBRATION_TARGET + \",\" + wig_tcp_pose_string + \"];\"\n  $ 184 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\n  $ 185 \"ur-call-function\"\n  wenglor_helpers_string_to_pose()\n  $ 186 \"ur-assignment\"\n  wg_target_pose = wg_object_pose\nend\n$ 187 \"ur-function\"\ndef wenglor_api_calibrate_to_target():\n  $ 188 \"ur-assignment\"\n  wig_command = \"calibration:target[\" + WG_USE_CASE + \",\" + WG_CALIBRATION_TARGET + \"];\"\n  $ 189 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\nend\n$ 190 \"ur-module\"\n$ 191 \"ur-function\"\ndef wenglor_helpers_connect_with_vision_device():\n  $ 192 \"ur-script\"\n  socket_ok=socket_open(WG_CAM_IP, WG_CAM_PORT, WIG_SOCKET_NAME)\n  if socket_ok == False:\n      popup(\"No connection to vision device. Program stopped.\", title=\"wenglor vision\", warning=False, error=True, blocking=True)\n      halt\n  end\nend\n$ 193 \"ur-function\"\ndef wenglor_helpers_send_command():\n  $ 194 \"ur-folder\"\n  $ 195 \"ur-assignment\"\n  global send_ok = socket_send_string(str=wig_command, socket_name=WIG_SOCKET_NAME)\n  $ 196 \"ur-if\"\n  if (send_ok == False):\n    $ 197 \"ur-assignment\"\n    wig_socket_error = True\n    $ 198 \"ur-script\"\n    textmsg(\"Sending \" + wig_command + \" failed.\",s2=\"\")\n  $ 199 \"ur-else\"\n  else:\n    $ 200 \"ur-assignment\"\n    wig_socket_error = False\n  end\nend\n$ 201 \"ur-function\"\ndef wenglor_helpers_receive_response():\n  $ 202 \"ur-assignment\"\n  global string_read = socket_read_string(socket_name=WIG_SOCKET_NAME,prefix=\"\",suffix=\"\\n\",interpret_escape=True, timeout=WIG_COMMAND_TIMEOUT)\n  $ 203 \"ur-if\"\n  if (str_empty(string_read)):\n    $ 204 \"ur-assignment\"\n    wig_socket_error = True\n    $ 205 \"ur-script\"\n    textmsg(\"Could not read from vision device\",s2=\"\")\n  $ 206 \"ur-else\"\n  else:\n    $ 207 \"ur-assignment\"\n    wig_socket_error = False\n    $ 208 \"ur-assignment\"\n    wig_camera_reply = string_read\n  end\nend\n$ 209 \"ur-function\"\ndef wenglor_helpers_send_and_read_string():\n  $ 210 \"ur-call-function\"\n  wenglor_helpers_send_command()\n  $ 211 \"ur-if\"\n  if (wig_socket_error == False):\n    $ 212 \"ur-comment\"\n    $ 213 \"ur-call-function\"\n    wenglor_helpers_receive_response()\n    $ 214 \"ur-call-function\"\n    wenglor_helpers_check_camera_reply()\n  end\nend\n$ 215 \"ur-function\"\ndef wenglor_helpers_change_job():\n  $ 216 \"ur-assignment\"\n  wig_command = \"job:change[\" + wig_job_name  + \"];\"\n  $ 217 \"ur-call-function\"\n  wenglor_helpers_send_and_read_string()\nend\n$ 218 \"ur-function\"\ndef wenglor_helpers_check_camera_reply():\n  $ 219 \"ur-if\"\n  if (str_empty(wig_camera_reply)):\n    $ 220 \"ur-comment\"\n    $ 221 \"ur-operator-input\"\n    popup(\"No reply from camera. Exiting program.\", \"error\", False, True, blocking=True)\n    $ 222 \"ur-halt\"\n    halt\n  end\n  $ 223 \"ur-if\"\n  if (wig_socket_error == True ):\n    $ 224 \"ur-operator-input\"\n    popup(\"Error during communication with vision device\", \"error\", False, True, blocking=True)\n    $ 225 \"ur-halt\"\n    halt\n  end\n  $ 226 \"ur-if\"\n  if (str_at(wig_camera_reply,0) == \"-\"):\n    $ 227 \"ur-assignment\"\n    global return_code = to_num(wig_camera_reply)\n    $ 228 \"ur-assignment\"\n    wig_error_code = return_code\n    $ 229 \"ur-call-function\"\n    wenglor_helpers_set_return_error()\n    $ 230 \"ur-if\"\n    if (wig_error_code == -5011):\n      $ 231 \"ur-comment\"\n      $ 232 \"ur-halt\"\n      halt\n    end\n  end\nend\n$ 233 \"ur-function\"\ndef wenglor_helpers_set_return_error():\n  $ 234 \"ur-assignment\"\n  global error_message = \"\"\n  $ 235 \"ur-assignment\"\n  global error_code_abs = norm(wig_error_code)\n  $ 236 \"ur-if\"\n  if (error_code_abs == 5001):\n    $ 237 \"ur-assignment\"\n    error_message = \"General Error\"\n  $ 238 \"ur-elseif\"\n  elif (error_code_abs == 5002):\n    $ 239 \"ur-assignment\"\n    error_message = \"Badly formatted request\"\n  $ 240 \"ur-elseif\"\n  elif (error_code_abs == 5003):\n    $ 241 \"ur-assignment\"\n    error_message = \"No connnection to uniVision\"\n  $ 242 \"ur-elseif\"\n  elif (error_code_abs == 5004):\n    $ 243 \"ur-assignment\"\n    error_message = \"Unknown uniVision job name\"\n    $ 244 \"ur-wait\"\n    sleep(5)\n  $ 245 \"ur-elseif\"\n  elif (error_code_abs == 5005):\n    $ 246 \"ur-assignment\"\n    error_message = \"Badly configured uniVision job\"\n  $ 247 \"ur-elseif\"\n  elif (error_code_abs == 5006):\n    $ 248 \"ur-assignment\"\n    error_message = \"Calibration failed\"\n  $ 249 \"ur-elseif\"\n  elif (error_code_abs == 5007):\n    $ 250 \"ur-assignment\"\n    error_message = \"No calibration data\"\n  $ 251 \"ur-elseif\"\n  elif (error_code_abs == 5008):\n    $ 252 \"ur-assignment\"\n    error_message = \"No object found\"\n  $ 253 \"ur-elseif\"\n  elif (error_code_abs == 5009):\n    $ 254 \"ur-assignment\"\n    error_message = \"Bad or empty device robot vision message\"\n  $ 255 \"ur-elseif\"\n  elif (error_code_abs == 5010):\n    $ 256 \"ur-assignment\"\n    error_message = \"Index error\"\n  $ 257 \"ur-elseif\"\n  elif (error_code_abs == 5011):\n    $ 258 \"ur-assignment\"\n    error_message = \"Calibration pose variation insufficient\"\n  $ 259 \"ur-else\"\n  else:\n    $ 260 \"ur-assignment\"\n    error_message = \"Unknown error code\"\n  end\n  $ 261 \"ur-script\"\n  popup(error_message, title=\"wenglor vision\", warning=True, error=False, blocking=True)\nend\n$ 262 \"ur-function\"\ndef wenglor_helpers_are_calibration_poses_set():\n  $ 263 \"ur-assignment\"\n  wig_poses_set = True\n  $ 264 \"ur-if\"\n  if (to_str(WG_CALIB_POSE_1) == to_str(WIG_EMPTY_POSE)):\n    $ 265 \"ur-assignment\"\n    wig_poses_set = False\n  $ 266 \"ur-elseif\"\n  elif (to_str(WG_CALIB_POSE_2) == to_str(WIG_EMPTY_POSE)):\n    $ 267 \"ur-assignment\"\n    wig_poses_set = False\n  $ 268 \"ur-elseif\"\n  elif (to_str(WG_CALIB_POSE_3) == to_str(WIG_EMPTY_POSE)):\n    $ 269 \"ur-assignment\"\n    wig_poses_set = False\n  $ 270 \"ur-elseif\"\n  elif (to_str(WG_CALIB_POSE_4) == to_str(WIG_EMPTY_POSE)):\n    $ 271 \"ur-assignment\"\n    wig_poses_set = False\n  $ 272 \"ur-elseif\"\n  elif (to_str(WG_CALIB_POSE_5) == to_str(WIG_EMPTY_POSE)):\n    $ 273 \"ur-assignment\"\n    wig_poses_set = False\n  end\nend\n$ 274 \"ur-function\"\ndef wenglor_helpers_update_tcp_pose_string():\n  $ 275 \"ur-assignment\"\n  wig_tcp_pose_string = to_str(get_actual_tcp_pose())\n  $ 276 \"ur-assignment\"\n  wig_tcp_pose_string = str_sub(wig_tcp_pose_string, 1)\nend\n$ 277 \"ur-function\"\ndef wenglor_helpers_string_to_pose():\n  $ 278 \"ur-script\"\n  # Find the value separators\n  # parameters of str_find(src, target, start_from=0)\n  comma_x = str_find(wig_camera_reply, \",\", 0)\n  comma_y = str_find(wig_camera_reply, \",\", comma_x + 1)\n  comma_z = str_find(wig_camera_reply, \",\", comma_y + 1)\n  comma_rx = str_find(wig_camera_reply, \",\", comma_z +1)\n  comma_ry = str_find(wig_camera_reply, \",\", comma_rx + 1)\n  # Extract the values as string\n  # parameters of str_sub(src,index,len)\n  # -1 at the end to not get the comma itself\n  x_str = str_sub(wig_camera_reply,   1,              comma_x -1)\n  y_str = str_sub(wig_camera_reply,   comma_x + 1,    comma_y - comma_x - 1)\n  z_str = str_sub(wig_camera_reply,   comma_y + 1,    comma_z - comma_y -1)\n  rx_str = str_sub(wig_camera_reply,  comma_z + 1,    comma_rx - comma_z -1)\n  ry_str = str_sub(wig_camera_reply,  comma_rx + 1,   comma_ry - comma_rx -1)\n  # first -1 to not get the closing paranthesis and the second to not get the comma\n  rz_str = str_sub(wig_camera_reply,  comma_ry + 1,   str_len(wig_camera_reply) -1 - comma_ry -1)\n  # Convert to numbers\n  x = to_num(x_str)\n  y = to_num(y_str)\n  z = to_num(z_str)\n  rx = to_num(rx_str)\n  ry = to_num(ry_str)\n  rz = to_num(rz_str)\n  wg_object_pose = p[x, y, z, rx, ry, rz]\nend\n$ 279 \"ur-function\"\ndef wenglor_helpers_calibrate_if_needed():\n  $ 280 \"ur-call-function\"\n  wenglor_api_update_camera_status()\n  $ 281 \"ur-comment\"\n  $ 282 \"ur-if\"\n  if (wig_calibration_done == False):\n    $ 283 \"ur-call-function\"\n    wenglor_api_run_calibration()\n    $ 284 \"ur-call-function\"\n    wenglor_api_update_camera_status()\n    $ 285 \"ur-if\"\n    if (wig_calibration_done == False):\n      $ 286 \"ur-comment\"\n      $ 287 \"ur-operator-input\"\n      popup(\"Exit program as calibration data is not available\", \"error\", False, True, blocking=True)\n      $ 288 \"ur-halt\"\n      halt\n    end\n  end\nend\n$ 289 \"ur-functions\"\n$ 290 \"ur-before-start\"\n$ 291 \"ur-comment\"\n$ 292 \"ur-folder\"\n$ 293 \"ur-assignment\"\nglobal WG_CAM_IP = \"192.168.100.1\"\n$ 294 \"ur-assignment\"\nglobal WG_CAM_PORT = 32006\n$ 295 \"ur-assignment\"\nglobal WG_CALIB_JOB = \"calibration.u3p\"\n$ 296 \"ur-assignment\"\nglobal WG_FIND_OBJECTS_JOB = \"find_objects.u3p\"\n$ 297 \"ur-assignment\"\nglobal WG_FIND_TARGET_JOB = \"find_target.u3p\"\n$ 298 \"ur-assignment\"\nglobal WG_USE_CASE = \"camera_on_robot\"\n$ 299 \"ur-assignment\"\nglobal WG_CALIBRATION_TARGET = \"zvzj001\"\n$ 300 \"ur-assignment\"\nglobal g_detection_pose = p[0,0,0,0,0,0]\n$ 301 \"ur-assignment\"\nglobal WG_CALIB_POSE_1 = p[0,0,0,0,0,0]\n$ 302 \"ur-assignment\"\nglobal WG_CALIB_POSE_2 = p[0,0,0,0,0,0]\n$ 303 \"ur-assignment\"\nglobal WG_CALIB_POSE_3 = p[0,0,0,0,0,0]\n$ 304 \"ur-assignment\"\nglobal WG_CALIB_POSE_4 = p[0,0,0,0,0,0]\n$ 305 \"ur-assignment\"\nglobal WG_CALIB_POSE_5 = p[0,0,0,0,0,0]\n$ 306 \"ur-assignment\"\nglobal WG_VALIDATION_OFFSET_Z_MM = 10\n$ 307 \"ur-assignment\"\nglobal WG_MACHINE_POSES_TAUGHT = False\n$ 308 \"ur-assignment\"\nglobal G_POSE_IN_MACHINE = struct(p=p[0.11039244303347624, -0.02845945142629941, -0.06219754730184143, 0.07410720804822273, 0.03292598837567368, 0.020299067994971744], frame=\"w_ref_frame\", q=[-1.5944282147157578, -1.4774794698837397, -1.9499960385869937, -1.3104715794265847, 1.595260757399235, -0.02472841090078237])\n$ 309 \"ur-folder\"\n$ 310 \"ur-assignment\"\nglobal wg_num_objects_found = 0\n$ 311 \"ur-assignment\"\nglobal wg_object_index = 0\n$ 312 \"ur-assignment\"\nglobal wg_object_pose = p[0,0,0,0,0,0]\n$ 313 \"ur-assignment\"\nglobal wg_shape_model = 0\n$ 314 \"ur-assignment\"\nglobal wg_additional_value = \"\"\n$ 315 \"ur-assignment\"\nglobal wg_target_pose = p[0,0,0,0,0,0]\n$ 316 \"ur-folder\"\n$ 317 \"ur-assignment\"\nglobal WIG_SOCKET_NAME = \"wenglor_socket\"\n$ 318 \"ur-assignment\"\nglobal wig_socket_error = False\n$ 319 \"ur-assignment\"\nglobal wig_error_code = 0\n$ 320 \"ur-assignment\"\nglobal wig_calibration_done = False\n$ 321 \"ur-assignment\"\nglobal wig_command = \"\"\n$ 322 \"ur-assignment\"\nglobal WIG_COMMAND_TIMEOUT = 20\n$ 323 \"ur-assignment\"\nglobal wig_job_name = \"\"\n$ 324 \"ur-assignment\"\nglobal wig_camera_reply = \"\"\n$ 325 \"ur-assignment\"\nglobal wig_poses_set = False\n$ 326 \"ur-assignment\"\nglobal wig_tcp_pose_string = \"\"\n$ 327 \"ur-assignment\"\nglobal WIG_EMPTY_POSE = p[0,0,0,0,0,0]\n$ 328 \"ur-assignment\"\nglobal wig_pose_empty = True\n$ 329 \"ur-code\"\n$ 330 \"ur-comment\"\n$ 331 \"ur-comment\"\n$ 332 \"ur-call-function\"\nwenglor_helpers_connect_with_vision_device()\n$ 333 \"ur-call-function\"\nwenglor_example