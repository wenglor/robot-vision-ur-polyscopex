ers":{}},"guid":"f4a404cf-7319-c88f-1889-a1582a39924e","parentId":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651","programLabel":"Status"},{"children":[{"children":[],"contributedNode":{"type":"ur-comment","version":"0.0.1","parameters":{"comment":"Author: wenglor sensoric GmbH"}},"guid":"be6129ba-ab90-37e1-eb22-668aceafdfb0","parentId":"5079b59e-02fb-c92f-e3c0-da2219399ee1","programLabel":[{"type":"secondary","value":"Author: wenglor sensoric GmbH"}]},{"children":[],"contributedNode":{"type":"ur-comment","version":"0.0.1","parameters":{"comment":"Version: 1.0.0"}},"guid":"795b42c8-6717-41e4-d95f-9066f8fac834","parentId":"5079b59e-02fb-c92f-e3c0-da2219399ee1","programLabel":[{"type":"secondary","value":"Version: 1.0.0"}]},{"children":[],"contributedNode":{"type":"ur-call-function","version":"0.0.1","allowsChildren":false,"parameters":{"selectedModule":{"name":"wenglor_examples","reference":true,"type":"$$Module"},"selectedFunction":{"type":"$$Function","declaredByID":"89b5289c-e72d-bfc6-fd54-b16a053250e6","name":"prepare_detection","reference":true}}},"guid":"47679feb-8b63-ce17-b5f1-a4ee4e8f0572","parentId":"5079b59e-02fb-c92f-e3c0-da2219399ee1","programLabel":[{"type":"secondary","value":"wenglor_examples"},{"type":"primary","value":"prepare_detection"}]}],"contributedNode":{"type":"ur-code","version":"0.0.1","allowsChildren":true,"lockChildren":false,"parameters":{"loopForever":false}},"guid":"5079b59e-02fb-c92f-e3c0-da2219399ee1","parentId":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651","programLabel":[{"type":"secondary","translationKey":"program-node-label.code.looping"},{"type":"secondary","translationKey":"program-node-label.code.disabled"}]}],"contributedNode":{"type":"ur-program","version":"0.0.1","allowsChildren":true,"lockChildren":true,"parameters":{"name":"Generic wenglor interface"}},"guid":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651"},"programInformation":{"name":"Generic wenglor interface","description":null,"createdDate":1746517038019,"lastSavedDate":1746529883208,"lastModifiedDate":null,"programState":"FINAL","functionsBlockShown":false},"urscript":{"script":"$ 1 \"Generic wenglor interface\"\n$ 2 \"Modules\"\n$ 3 \"wenglor_examples\"\n$ 4 \"\"\ndef wenglor_examples_prepare_detection():\n  $ 5 \"Connect with wenglor vision device\"\n  socket_ok=socket_open(g_cam_ip, g_cam_port, wig_socket_name)\n  if socket_ok == False:\n      popup(\"No connection to vision device. Program stopped.\", title=\"wenglor vision\", warning=False, error=True, blocking=True)\n      halt\n  end\n  $ 6 \"wenglor_apiupdate_camera_state\"\n  wenglor_api_update_camera_state()\n  $ 7 \"Run calibration procedure if camera to robot is not already calibrated\"\n  $ 8 \"wig_calibration_done == False\"\n  if (wig_calibration_done == False):\n    $ 9 \"wenglor_apirun_calibration\"\n    wenglor_api_run_calibration()\n  end\n  $ 10 \"Check if detection pose was set\"\n  $ 11 \"to_str(g_detection_pose) == to_str(wig_empty_pose)\"\n  if (to_str(g_detection_pose) == to_str(wig_empty_pose)):\n    $ 12 \"\"\n    popup(\"Exit program as g_detection_pose pose is not set\", \"error\", False, True, blocking=True)\n    $ 13 \"\"\n    halt\n  end\n  $ 14 \"wenglor_apiupdate_camera_state\"\n  wenglor_api_update_camera_state()\n  $ 15 \"calibration data required, so abort, when they are still not available\"\n  $ 16 \"wig_calibration_done == False\"\n  if (wig_calibration_done == False):\n    $ 17 \"\"\n    popup(\"Exit program as calibration data is not available\", \"error\", False, True, blocking=True)\n    $ 18 \"\"\n    halt\n  end\n  $ 19 \"wenglor_apiload_find_object_job\"\n  wenglor_api_load_find_object_job()\n  $ 20 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\nend\n$ 21 \"\"\ndef wenglor_examples_single_detection():\n  $ 22 \"picking_speed_m_s:0.25\"\n  global picking_speed_m_s = 0.25\n  $ 23 \"picking_acceleration_m_s2:1.2\"\n  global picking_acceleration_m_s2 = 1.2\n  $ 24 \"wenglor_examplesprepare_detection\"\n  wenglor_examples_prepare_detection()\n  $ 25 \"wenglor_apidetect_objects\"\n  wenglor_api_detect_objects()\n  $ 26 \"Move to: calib_target_pose Linear, S: validation_speed_m_s, A: validation_acceleration_m_s2\"\n  movel(g_object_pose,a=picking_acceleration_m_s2, v=picking_speed_m_s, t=0, r=0)\nend\n$ 27 \"\"\ndef wenglor_examples_multi_detection():\n  $ 28 \"picking_speed_m_s:0.25\"\n  picking_speed_m_s = 0.25\n  $ 29 \"picking_acceleration_m_s2:1.2\"\n  picking_acceleration_m_s2 = 1.2\n  $ 30 \"g_object_index:0\"\n  g_object_index = 0\n  $ 31 \"wenglor_examplesprepare_detection\"\n  wenglor_examples_prepare_detection()\n  $ 32 \"wenglor_apidetect_objects\"\n  wenglor_api_detect_objects()\n  $ 33 \"wenglor_apiread_num_objects\"\n  wenglor_api_read_num_objects()\n  $ 34 \"\"\n  while (g_object_index < g_num_objects_found):\n    $ 35 \"wenglor_apipose_by_index\"\n    wenglor_api_pose_by_index()\n    $ 36 \"wenglor_apishape_by_index\"\n    wenglor_api_shape_by_index()\n    $ 37 \"wenglor_apivalue_by_index\"\n    wenglor_api_value_by_index()\n    $ 38 \"Move to: g_object_pose Linear, S: picking_speed_m_s, A: picking_acceleration_m_s2\"\n    movel(g_object_pose,a=picking_acceleration_m_s2, v=picking_speed_m_s, t=0, r=0)\n    $ 39 \"g_object_index:g_object_index + 1\"\n    g_object_index = g_object_index + 1\n  end\nend\n$ 40 \"wenglor_api\"\n$ 41 \"\"\ndef wenglor_api_load_calibration_job():\n  $ 42 \"wig_job_name:g_calib_job\"\n  wig_job_name = g_calib_job\n  $ 43 \"wenglor_helperschange_job\"\n  wenglor_helpers_change_job()\nend\n$ 44 \"\"\ndef wenglor_api_load_find_object_job():\n  $ 45 \"wig_job_name:g_find_objects_job\"\n  wig_job_name = g_find_objects_job\n  $ 46 \"wenglor_helperschange_job\"\n  wenglor_helpers_change_job()\nend\n$ 47 \"\"\ndef wenglor_api_update_camera_state():\n  $ 48 \"wig_command:'state[' + g_use_case +  '];'\"\n  wig_command = \"state[\" + g_use_case +  \"];\"\n  $ 49 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 50 \"wig_socket_error == False\"\n  if (wig_socket_error == False):\n    $ 51 \"str_at(wig_camera_reply,0) == '0'\"\n    if (str_at(wig_camera_reply,0) == \"0\"):\n      $ 52 \"wig_camera_error:False\"\n      wig_camera_error = False\n    $ 53 \"str_at(wig_camera_reply,0) == '1'\"\n    elif (str_at(wig_camera_reply,0) == \"1\"):\n      $ 54 \"wig_camera_error:True\"\n      wig_camera_error = True\n    $ 55 \"\"\n    else:\n      $ 56 \"textmsg unknown camera state\"\n      textmsg(s1=\"Unknown camera state: \" + str_at(wig_camera_reply,0),s2=\"\")\n    end\n    $ 57 \"str_at(wig_camera_reply,1) == '0'\"\n    if (str_at(wig_camera_reply,1) == \"0\"):\n      $ 58 \"wig_calibration_done:False\"\n      wig_calibration_done = False\n    $ 59 \"str_at(wig_camera_reply,1) == '1'\"\n    elif (str_at(wig_camera_reply,1) == \"1\"):\n      $ 60 \"wig_calibration_done:True\"\n      wig_calibration_done = True\n    $ 61 \"\"\n    else:\n      $ 62 \"textmsg unknown camera state\"\n      textmsg(s1=\"Unknown calibration state: \" + str_at(wig_camera_reply,1),s2=\"\")\n    end\n  end\nend\n$ 63 \"\"\ndef wenglor_api_run_calibration():\n  $ 64 \"wenglor_helpersare_calibration_poses_set\"\n  wenglor_helpers_are_calibration_poses_set()\n  $ 65 \"wig_poses_set == False\"\n  if (wig_poses_set == False):\n    $ 66 \"\"\n    popup(\"Exit program as calibration poses are not set.\", \"error\", False, True, blocking=True)\n    $ 67 \"\"\n    halt\n  end\n  $ 68 \"wenglor_apiupdate_camera_state\"\n  wenglor_api_update_camera_state()\n  $ 69 \"wig_calibration_done == True\"\n  if (wig_calibration_done == True):\n    $ 70 \"\"\n    global answer = request_boolean_from_primary_client(\"Calibration already done. Would you like to redo it?\")\n    $ 71 \"answer == False\"\n    if (answer == False):\n      $ 72 \"return None\"\n      return None\n    end\n  end\n  $ 73 \"To prevent old calibratio data are used, we clear the buffer\"\n  $ 74 \"wig_command:'calibration:clear;'\"\n  wig_command = \"calibration:clear;\"\n  $ 75 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 76 \"wenglor_apiload_calibration_job\"\n  wenglor_api_load_calibration_job()\n  $ 77 \"str_empty(wig_error_string) == False\"\n  if (str_empty(wig_error_string) == False):\n    $ 78 \"\"\n    popup(\"Exit program as calibration job could not be loaded\", \"error\", False, True, blocking=True)\n    $ 79 \"\"\n    halt\n  end\n  $ 80 \"g_use_case == 'camera_not_on_robot'\"\n  if (g_use_case == \"camera_not_on_robot\"):\n    $ 81 \"\"\n    popup(\"Confirm when calibration board was mounted and correct tool is selected.\", \"info\", False, False, blocking=True)\n  $ 82 \"g_use_case == 'camera_on_robot'\"\n  elif (g_use_case == \"camera_on_robot\"):\n    $ 83 \"\"\n    popup(\"Confirm when calibration board was placed and correct tool is selected.\", \"info\", False, False, blocking=True)\n  $ 84 \"\"\n  else:\n    $ 85 \"\"\n    popup(\"Unknown use case. Program was aborted.\", \"error\", False, True, blocking=True)\n    $ 86 \"\"\n    halt\n  end\n  $ 87 \"calib_pose_1\"\n  $ 88 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_calib_pose_1.p, g_calib_pose_1.frame, \"base\"), qnear=g_calib_pose_1.q), a=0.09, v=0.3)\n  $ 89 \"0.50 s\"\n  sleep(0.5)\n  $ 90 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 91 \"wig_command:'calibration:add[' + wig_tcp_pose_string + '];'\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\n  $ 92 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 93 \"calib_pose_2\"\n  $ 94 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_calib_pose_2.p, g_calib_pose_2.frame, \"base\"), qnear=g_calib_pose_2.q), a=0.09, v=0.3)\n  $ 95 \"0.50 s\"\n  sleep(0.5)\n  $ 96 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 97 \"wig_command:'calibration:add[' + wig_tcp_pose_string + '];'\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\n  $ 98 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 99 \"calib_pose_3\"\n  $ 100 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_calib_pose_3.p, g_calib_pose_3.frame, \"base\"), qnear=g_calib_pose_3.q), a=0.09, v=0.3)\n  $ 101 \"0.50 s\"\n  sleep(0.5)\n  $ 102 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 103 \"wig_command:'calibration:add[' + wig_tcp_pose_string + '];'\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\n  $ 104 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 105 \"calib_pose_4\"\n  $ 106 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_calib_pose_4.p, g_calib_pose_4.frame, \"base\"), qnear=g_calib_pose_4.q), a=0.09, v=0.3)\n  $ 107 \"0.50 s\"\n  sleep(0.5)\n  $ 108 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 109 \"wig_command:'calibration:add[' + wig_tcp_pose_string + '];'\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\n  $ 110 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 111 \"calib_pose_5\"\n  $ 112 \"\"\n  optimovej(get_inverse_kin(convert_pose(g_calib_pose_5.p, g_calib_pose_5.frame, \"base\"), qnear=g_calib_pose_5.q), a=0.09, v=0.3)\n  $ 113 \"0.50 s\"\n  sleep(0.5)\n  $ 114 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 115 \"wig_command:'calibration:add[' + wig_tcp_pose_string + '];'\"\n  wig_command = \"calibration:add[\" + wig_tcp_pose_string + \"];\"\n  $ 116 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 117 \"Add more calibration poses if wanted\"\n  $ 118 \"wig_command:'calibration:calculate[' + g_use_case + ',' + g_calibration_target + '];'\"\n  wig_command = \"calibration:calculate[\" + g_use_case + \",\" + g_calibration_target + \"];\"\n  $ 119 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 120 \"str_empty(wig_error_string) == False\"\n  if (str_empty(wig_error_string) == False):\n    $ 121 \"\"\n    popup(\"Exit program as calibration failed\", \"error\", False, True, blocking=True)\n    $ 122 \"\"\n    halt\n  end\n  $ 123 \"write reprojection error to log\"\n  textmsg(\"Reprojection error: \" + wig_camera_reply,s2=\"\")\n  $ 124 \"g_use_case == 'camera_on_robot'\"\n  if (g_use_case == \"camera_on_robot\"):\n    $ 125 \"For the camera on robot case, the first calibration pose is also the detection pose.\"\n    $ 126 \"g_detection_pose:g_calib_pose_1\"\n    g_detection_pose = g_calib_pose_1\n  $ 127 \"g_use_case == 'camera_not_on_robot'\"\n  elif (g_use_case == \"camera_not_on_robot\"):\n    $ 128 \"to_str(g_detection_pose) == to_str(wig_empty_pose)\"\n    if (to_str(g_detection_pose) == to_str(wig_empty_pose)):\n      $ 129 \"\"\n      popup(\"Exit program as wenglorDetection pose is not set.\", \"error\", False, True, blocking=True)\n      $ 130 \"\"\n      halt\n    end\n    $ 131 \"\"\n    optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n    $ 132 \"\"\n    global user_input = request_boolean_from_primary_client(\"Confirm when calibration board was placed on object ground.\")\n    $ 133 \"user_input == True\"\n    if (user_input == True):\n      $ 134 \"wig_command:'calibration:ground[' + g_calibration_target + '];'\"\n      wig_command = \"calibration:ground[\" + g_calibration_target + \"];\"\n      $ 135 \"wenglor_helperssend_and_read_string\"\n      wenglor_helpers_send_and_read_string()\n      $ 136 \"str_empty(wig_error_string) == False\"\n      if (str_empty(wig_error_string) == False):\n        $ 137 \"If calibration step two failed proceeding does not make sence\"\n        $ 138 \"\"\n        halt\n      $ 139 \"\"\n      else:\n        $ 140 \"\"\n        popup(\"Calibration step 2 done.\", \"info\", False, False, blocking=True)\n      end\n    $ 141 \"\"\n    else:\n      $ 142 \"\"\n      popup(\"Calibration step 2 canceled. Program will exit\", \"warning\", True, False, blocking=True)\n      $ 143 \"\"\n      halt\n    end\n  end\nend\n$ 144 \"\"\ndef wenglor_api_validate_calibration():\n  $ 145 \"\"\n  global user_input = request_boolean_from_primary_client(\"Do you want to validate the calibration?\")\n  $ 146 \"user_input == False\"\n  if (user_input == False):\n    $ 147 \"\"\n    popup(\"Validation skipped.\", \"info\", False, False, blocking=True)\n    $ 148 \"return None\"\n    return None\n  $ 149 \"\"\n  else:\n    $ 150 \"to_str(g_detection_pose) == to_str(wig_empty_pose)\"\n    if (to_str(g_detection_pose) == to_str(wig_empty_pose)):\n      $ 151 \"textmsg('Detection pose is not set',s2='')\"\n      textmsg(\"Detection pose is not set\",s2=\"\")\n      $ 152 \"return None\"\n      return None\n    end\n    $ 153 \"\"\n    optimovej(get_inverse_kin(convert_pose(g_detection_pose.p, g_detection_pose.frame, \"base\"), qnear=g_detection_pose.q), a=0.09, v=0.3)\n    $ 154 \"wenglor_helpersupdate_tcp_pose_string\"\n    wenglor_helpers_update_tcp_pose_string()\n    $ 155 \"wig_command:'validate['+ g_use_case + ',' + wig_tcp_pose_string + '];'\"\n    wig_command = \"validate[\"+ g_use_case + \",\" + wig_tcp_pose_string + \"];\"\n    $ 156 \"wenglor_helperssend_and_read_string\"\n    wenglor_helpers_send_and_read_string()\n    $ 157 \"str_empty(wig_error_string) == False \"\n    if (str_empty(wig_error_string) == False ):\n      $ 158 \"In an error case, do not proceed with pose processing\"\n      $ 159 \"return None\"\n      return None\n    end\n    $ 160 \"wig_is_validation:True\"\n    wig_is_validation = True\n    $ 161 \"wenglor_helpersparse_received_pose\"\n    wenglor_helpers_parse_received_pose()\n    $ 162 \"calib_target_pose:g_object_pose\"\n    global calib_target_pose = g_object_pose\n    $ 163 \"validation_speed_m_s:0.25\"\n    global validation_speed_m_s = 0.25\n    $ 164 \"validation_acceleration_m_s2:1.2\"\n    global validation_acceleration_m_s2 = 1.2\n    $ 165 \"Move to: calib_target_pose Linear, S: validation_speed_m_s, A: validation_acceleration_m_s2\"\n    movel(calib_target_pose,a=validation_acceleration_m_s2, v=validation_speed_m_s, t=0, r=0)\n  end\nend\n$ 166 \"\"\ndef wenglor_api_detect_objects():\n  $ 167 \"wenglor_helpersupdate_tcp_pose_string\"\n  wenglor_helpers_update_tcp_pose_string()\n  $ 168 \"wig_command:'detect['+ g_use_case + ',' + wig_tcp_pose_string + '];'\"\n  wig_command = \"detect[\"+ g_use_case + \",\" + wig_tcp_pose_string + \"];\"\n  $ 169 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 170 \"str_empty(wig_error_string) == False \"\n  if (str_empty(wig_error_string) == False ):\n    $ 171 \"In an error case, do not proceed with pose processing\"\n    $ 172 \"return None\"\n    return None\n  end\n  $ 173 \"wig_is_validation:False\"\n  wig_is_validation = False\n  $ 174 \"wenglor_helpersparse_received_pose\"\n  wenglor_helpers_parse_received_pose()\nend\n$ 175 \"\"\ndef wenglor_api_read_num_objects():\n  $ 176 \"wig_command:'num_objects:get;'\"\n  wig_command = \"num_objects:get;\"\n  $ 177 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 178 \"str_empty(wig_error_string) == False\"\n  if (str_empty(wig_error_string) == False):\n    $ 179 \"\"\n    $ 180 \"g_num_objects_found:-1\"\n    g_num_objects_found = -1\n    $ 181 \"return None\"\n    return None\n  end\n  $ 182 \"g_num_objects_found:to_num(wig_camera_reply)\"\n  g_num_objects_found = to_num(wig_camera_reply)\nend\n$ 183 \"\"\ndef wenglor_api_pose_by_index():\n  $ 184 \"wig_command:'pose:get[' + to_str(g_object_index) +'];'\"\n  wig_command = \"pose:get[\" + to_str(g_object_index) +\"];\"\n  $ 185 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 186 \"str_empty(wig_error_string) == False \"\n  if (str_empty(wig_error_string) == False ):\n    $ 187 \"In an error case, do not proceed with pose processing\"\n    $ 188 \"g_object_pose:get_actual_tcp_pose()\"\n    g_object_pose = get_actual_tcp_pose()\n    $ 189 \"return None\"\n    return None\n  end\n  $ 190 \"wig_is_validation:False\"\n  wig_is_validation = False\n  $ 191 \"wenglor_helpersparse_received_pose\"\n  wenglor_helpers_parse_received_pose()\nend\n$ 192 \"\"\ndef wenglor_api_shape_by_index():\n  $ 193 \"wig_command:'shape:get[' + to_str(g_object_index) +'];'\"\n  wig_command = \"shape:get[\" + to_str(g_object_index) +\"];\"\n  $ 194 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 195 \"str_empty(wig_error_string) == False\"\n  if (str_empty(wig_error_string) == False):\n    $ 196 \"\"\n    $ 197 \"g_shape_model:-1\"\n    g_shape_model = -1\n    $ 198 \"return None\"\n    return None\n  end\n  $ 199 \"g_shape_model:to_num(wig_camera_reply)\"\n  g_shape_model = to_num(wig_camera_reply)\nend\n$ 200 \"\"\ndef wenglor_api_value_by_index():\n  $ 201 \"wig_command:'value:get[' + to_str(g_object_index) +'];'\"\n  wig_command = \"value:get[\" + to_str(g_object_index) +\"];\"\n  $ 202 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\n  $ 203 \"str_empty(wig_error_string) == False\"\n  if (str_empty(wig_error_string) == False):\n    $ 204 \"\"\n    $ 205 \"g_additional_value:''\"\n    g_additional_value = \"\"\n    $ 206 \"return None\"\n    return None\n  end\n  $ 207 \"g_additional_value:wig_camera_reply\"\n  g_additional_value = wig_camera_reply\nend\n$ 208 \"wenglor_helpers\"\n$ 209 \"\"\ndef wenglor_helpers_send_string():\n  $ 210 \"helper\"\n  $ 211 \"send_ok:socket_send_string(str=wig_command, socket_name=wig_socket_name)\"\n  global send_ok = socket_send_string(str=wig_command, socket_name=wig_socket_name)\n  $ 212 \"send_ok == False\"\n  if (send_ok == False):\n    $ 213 \"wig_socket_error:True\"\n    wig_socket_error = True\n    $ 214 \"textmsg sending string failed\"\n    textmsg(\"Sending \" + wig_command + \" failed.\",s2=\"\")\n  $ 215 \"\"\n  else:\n    $ 216 \"wig_socket_error:False\"\n    wig_socket_error = False\n  end\nend\n$ 217 \"\"\ndef wenglor_helpers_read_string():\n  $ 218 \"string_read:socket_read_string(socket_name=wig_socket_name,prefix='',suffix='\\n',interpret_escape=True, timeout=5)\"\n  global string_read = socket_read_string(socket_name=wig_socket_name,prefix=\"\",suffix=\"\\n\",interpret_escape=True, timeout=5)\n  $ 219 \"str_empty(string_read)\"\n  if (str_empty(string_read)):\n    $ 220 \"wig_socket_error:True\"\n    wig_socket_error = True\n    $ 221 \"textmsg: could not read from vision device\"\n    textmsg(\"Could not read from vision device\",s2=\"\")\n  $ 222 \"\"\n  else:\n    $ 223 \"wig_socket_error:False\"\n    wig_socket_error = False\n    $ 224 \"wig_camera_reply:string_read\"\n    wig_camera_reply = string_read\n  end\nend\n$ 225 \"\"\ndef wenglor_helpers_send_and_read_string():\n  $ 226 \"wenglor_helperssend_string\"\n  wenglor_helpers_send_string()\n  $ 227 \"wig_socket_error == False\"\n  if (wig_socket_error == False):\n    $ 228 \"Only read if there was no socket error while sending\"\n    $ 229 \"wenglor_helpersread_string\"\n    wenglor_helpers_read_string()\n    $ 230 \"wenglor_helperscheck_camera_reply\"\n    wenglor_helpers_check_camera_reply()\n  end\nend\n$ 231 \"\"\ndef wenglor_helpers_change_job():\n  $ 232 \"wig_command:'job:change[' + wig_job_name  + '];'\"\n  wig_command = \"job:change[\" + wig_job_name  + \"];\"\n  $ 233 \"wenglor_helperssend_and_read_string\"\n  wenglor_helpers_send_and_read_string()\nend\n$ 234 \"\"\ndef wenglor_helpers_check_camera_reply():\n  $ 235 \"str_empty(wig_camera_reply)\"\n  if (str_empty(wig_camera_reply)):\n    $ 236 \"wig_error_string:'General Error'\"\n    wig_error_string = \"General Error\"\n  $ 237 \"\"\n  else:\n    $ 238 \"Set to general error, as parsing error causes in popup and cannot be caught\"\n    $ 239 \"wig_error_string:'General Error'\"\n    wig_error_string = \"General Error\"\n    $ 240 \"str_at(wig_camera_reply,0) == '-'\"\n    if (str_at(wig_camera_reply,0) == \"-\"):\n      $ 241 \"return_code:to_num(wig_camera_reply)\"\n      global return_code = to_num(wig_camera_reply)\n      $ 242 \"wig_error_code:return_code\"\n      wig_error_code = return_code\n      $ 243 \"wenglor_helpersinterpret_error_code\"\n      wenglor_helpers_interpret_error_code()\n    $ 244 \"\"\n    else:\n      $ 245 \"reset error string if everything is ok\"\n      $ 246 \"wig_error_string:''\"\n      wig_error_string = \"\"\n    end\n  end\nend\n$ 247 \"\"\ndef wenglor_helpers_interpret_error_code():\n  $ 248 \"error_code_abs:norm(wig_error_code)\"\n  global error_code_abs = norm(wig_error_code)\n  $ 249 \"error_code_abs == 5001\"\n  if (error_code_abs == 5001):\n    $ 250 \"wig_error_string:'General Error'\"\n    wig_error_string = \"General Error\"\n  $ 251 \"error_code_abs == 5002\"\n  elif (error_code_abs == 5002):\n    $ 252 \"wig_error_string:'Badly formatted request'\"\n    wig_error_string = \"Badly formatted request\"\n  $ 253 \"error_code_abs == 5003\"\n  elif (error_code_abs == 5003):\n    $ 254 \"wig_error_string:'No connnection to univision'\"\n    wig_error_string = \"No connnection to univision\"\n  $ 255 \"error_code_abs == 5004\"\n  elif (error_code_abs == 5004):\n    $ 256 \"wig_error_string:'Unknown univision job name'\"\n    wig_error_string = \"Unknown univision job name\"\n    $ 257 \"5.00 s\"\n    sleep(5)\n  $ 258 \"error_code_abs == 5005\"\n  elif (error_code_abs == 5005):\n    $ 259 \"wig_error_string:'Badly configured univision job'\"\n    wig_error_string = \"Badly configured univision job\"\n  $ 260 \"error_code_abs == 5006\"\n  elif (error_code_abs == 5006):\n    $ 261 \"wig_error_string:'Calibration failed'\"\n    wig_error_string = \"Calibration failed\"\n  $ 262 \"error_code_abs == 5007\"\n  elif (error_code_abs == 5007):\n    $ 263 \"wig_error_string:'No calibration data'\"\n    wig_error_string = \"No calibration data\"\n  $ 264 \"error_code_abs == 5008\"\n  elif (error_code_abs == 5008):\n    $ 265 \"wig_error_string:'No object found'\"\n    wig_error_string = \"No object found\"\n  $ 266 \"error_code_abs == 5009\"\n  elif (error_code_abs == 5009):\n    $ 267 \"wig_error_string:'Bad or empty device robot vision message'\"\n    wig_error_string = \"Bad or empty device robot vision message\"\n  $ 268 \"error_code_abs == 5010\"\n  elif (error_code_abs == 5010):\n    $ 269 \"wig_error_string:'Index error'\"\n    wig_error_string = \"Index error\"\n  $ 270 \"\"\n  else:\n    $ 271 \"wig_error_string:'Unknown error code'\"\n    wig_error_string = \"Unknown error code\"\n  end\n  $ 272 \"Blocking error message popup\"\n  popup(wig_error_string, title=\"wenglor vision\", warning=True, error=False, blocking=True)\nend\n$ 273 \"\"\ndef wenglor_helpers_are_calibration_poses_set():\n  $ 274 \"wig_poses_set:True\"\n  wig_poses_set = True\n  $ 275 \"to_str(g_calib_pose_1) == to_str(wig_empty_pose)\"\n  if (to_str(g_calib_pose_1) == to_str(wig_empty_pose)):\n    $ 276 \"wig_poses_set:False\"\n    wig_poses_set = False\n  $ 277 \"to_str(g_calib_pose_2) == to_str(wig_empty_pose)\"\n  elif (to_str(g_calib_pose_2) == to_str(wig_empty_pose)):\n    $ 278 \"wig_poses_set:False\"\n    wig_poses_set = False\n  $ 279 \"to_str(g_calib_pose_3) == to_str(wig_empty_pose)\"\n  elif (to_str(g_calib_pose_3) == to_str(wig_empty_pose)):\n    $ 280 \"wig_poses_set:False\"\n    wig_poses_set = False\n  $ 281 \"to_str(g_calib_pose_4) == to_str(wig_empty_pose)\"\n  elif (to_str(g_calib_pose_4) == to_str(wig_empty_pose)):\n    $ 282 \"wig_poses_set:False\"\n    wig_poses_set = False\n  $ 283 \"to_str(g_calib_pose_5) == to_str(wig_empty_pose)\"\n  elif (to_str(g_calib_pose_5) == to_str(wig_empty_pose)):\n    $ 284 \"wig_poses_set:False\"\n    wig_poses_set = False\n  end\nend\n$ 285 \"\"\ndef wenglor_helpers_update_tcp_pose_string():\n  $ 286 \"wig_tcp_pose_string:to_str(get_actual_tcp_pose())\"\n  wig_tcp_pose_string = to_str(get_actual_tcp_pose())\n  $ 287 \"wig_tcp_pose_string:str_sub(wig_tcp_pose_string, 1)\"\n  wig_tcp_pose_string = str_sub(wig_tcp_pose_string, 1)\nend\n$ 288 \"\"\ndef wenglor_helpers_parse_received_pose():\n  $ 289 \"z_offset_mm:0\"\n  z_offset_mm = 0\n  $ 290 \"wig_is_validation == True\"\n  if (wig_is_validation == True):\n    $ 291 \"z_offset_mm:g_validation_z_offset_mm\"\n    global z_offset_mm = g_validation_z_offset_mm\n  end\n  $ 292 \"parse pose and write to g_object_pose\"\n  # Find the value separators\n  # parameters of str_find(src, target, start_from=0)\n  comma_x = str_find(wig_camera_reply, \",\", 0)\n  comma_y = str_find(wig_camera_reply, \",\", comma_x + 1)\n  comma_z = str_find(wig_camera_reply, \",\", comma_y + 1)\n  comma_rx = str_find(wig_camera_reply, \",\", comma_z +1)\n  comma_ry = str_find(wig_camera_reply, \",\", comma_rx + 1)\n  # Extract the values as string\n  # parameters of str_sub(src,index,len)\n  # -1 at the end to not get the comma itself\n  x_str = str_sub(wig_camera_reply,   1,              comma_x -1)\n  y_str = str_sub(wig_camera_reply,   comma_x + 1,    comma_y - comma_x - 1)\n  z_str = str_sub(wig_camera_reply,   comma_y + 1,    comma_z - comma_y -1)\n  rx_str = str_sub(wig_camera_reply,  comma_z + 1,    comma_rx - comma_z -1)\n  ry_str = str_sub(wig_camera_reply,  comma_rx + 1,   comma_ry - comma_rx -1)\n  # first -1 to not get the closing paranthesis and the second to not get the comma\n  rz_str = str_sub(wig_camera_reply,  comma_ry + 1,   str_len(wig_camera_reply) -1 - comma_ry -1)\n  # Convert to numbers\n  x = to_num(x_str)\n  y = to_num(y_str)\n  z = to_num(z_str)\n  rx = to_num(rx_str)\n  ry = to_num(ry_str)\n  rz = to_num(rz_str)\n  # Add safety offset\n  z = z + (z_offset_mm / 1000)\n  g_object_pose = p[x, y, z, rx, ry, rz]\nend\n$ 293 \"\"\n$ 294 \"Before