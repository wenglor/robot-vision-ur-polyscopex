each"}},"guid":"c37453a8-6f9e-1cc6-8db3-dad254d8c817","parentId":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","programLabel":[{"type":"primary","value":"z_offset_mm:"},{"type":"secondary","value":"0"}]},{"children":[{"children":[],"contributedNode":{"type":"ur-assignment","version":"0.0.2","allowsChildren":false,"parameters":{"variable":{"entity":{"name":"z_offset_mm","reference":false,"type":"$$Variable","valueType":"float","declaredByID":"810d806a-5090-5e2f-fc4c-a78fb890a801"},"selectedType":"VARIABLE","value":"g_validation_z_offset_mm"},"waypointType":"teach"}},"guid":"810d806a-5090-5e2f-fc4c-a78fb890a801","parentId":"a8e3d1f1-ca62-8d94-475e-0c3cfc975b97","programLabel":[{"type":"primary","value":"z_offset_mm:"},{"type":"secondary","value":"g_validation_z_offset_mm"}]}],"contributedNode":{"type":"ur-if","version":"0.0.1","allowsChildren":true,"parameters":{"expression":"wig_is_validation == True"}},"guid":"a8e3d1f1-ca62-8d94-475e-0c3cfc975b97","parentId":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","programLabel":[{"type":"secondary","value":"wig_is_validation == True"}]},{"children":[],"contributedNode":{"type":"ur-script","version":"0.0.1","parameters":{"name":"parse pose and write to g_object_pose","expression":"# Find the value separators\n# parameters of str_find(src, target, start_from=0)\ncomma_x = str_find(wig_camera_reply, \",\", 0)\ncomma_y = str_find(wig_camera_reply, \",\", comma_x + 1)\ncomma_z = str_find(wig_camera_reply, \",\", comma_y + 1)\ncomma_rx = str_find(wig_camera_reply, \",\", comma_z +1)\ncomma_ry = str_find(wig_camera_reply, \",\", comma_rx + 1)\n\n# Extract the values as string\n# parameters of str_sub(src,index,len)\n# -1 at the end to not get the comma itself\nx_str = str_sub(wig_camera_reply,   1,              comma_x -1)\ny_str = str_sub(wig_camera_reply,   comma_x + 1,    comma_y - comma_x - 1)\nz_str = str_sub(wig_camera_reply,   comma_y + 1,    comma_z - comma_y -1)\nrx_str = str_sub(wig_camera_reply,  comma_z + 1,    comma_rx - comma_z -1)\nry_str = str_sub(wig_camera_reply,  comma_rx + 1,   comma_ry - comma_rx -1)\n# first -1 to not get the closing paranthesis and the second to not get the comma\nrz_str = str_sub(wig_camera_reply,  comma_ry + 1,   str_len(wig_camera_reply) -1 - comma_ry -1)\n\n# Convert to numbers\nx = to_num(x_str)\ny = to_num(y_str)\nz = to_num(z_str)\nrx = to_num(rx_str)\nry = to_num(ry_str)\nrz = to_num(rz_str)\n\n# Add safety offset\nz = z + (z_offset_mm / 1000)\n\ng_object_pose = p[x, y, z, rx, ry, rz]","valid":true}},"guid":"7ce9629d-057b-8f84-06e3-d3c56b4d6670","parentId":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","programLabel":"parse pose and write to g_object_pose"}],"contributedNode":{"type":"ur-function","version":"0.0.1","allowsChildren":true,"parameters":{"isAsync":false,"function":{"name":"parse_received_pose","reference":false,"type":"$$Function","declaredByID":"bcd21bb8-3dcf-da5b-ead5-890b55c60559"},"isLooping":false}},"guid":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","parentId":"31f3b476-fd63-184e-2751-a050215d93e8","programLabel":[{"type":"primary","translationKey":"program-node-label.single-value","interpolateParams":{"value":"parse_received_pose"}}]}],"contributedNode":{"type":"ur-module","version":"0.0.1","allowsChildren":true,"parameters":{"module":{"name":"wenglor_helpers","reference":false,"type":"$$Module","declaredByID":"31f3b476-fd63-184e-2751-a050215d93e8"}}},"guid":"31f3b476-fd63-184e-2751-a050215d93e8","parentId":"75f2fa92-8b5a-95fa-9d45-dca8ce7746bb","programLabel":"wenglor_helpers"}],"contributedNode":{"type":"ur-modules","version":"0.0.1","allowsChildren":true,"lockChildren":false},"guid":"75f2fa92-8b5a-95fa-9d45-dca8ce7746bb","parentId":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651","programLabel":"Modules"},{"children":[],"contributedNode":{"type":"ur-functions","version":"0.0.1","allowsChildren":true,"lockChildren":false},"guid":"8999039e-0d45-c583-402a-b8503a2e9990","parentId":"ab6e70aa-51c9-dfe0-f6bc-69b939d48651","programLabel":""},{"children":[{"children":[]