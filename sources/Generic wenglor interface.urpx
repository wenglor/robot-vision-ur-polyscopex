.2","allowsChildren":false,"parameters":{"variable":{"entity":{"name":"wig_tcp_pose_string","reference":true,"type":"$$Variable","valueType":"string","declaredByID":"dd9afbde-a327-aca4-15ae-ebfd0cb1aa1b"},"selectedType":"VALUE","value":"to_str(get_actual_tcp_pose())"},"waypointType":"teach"}},"guid":"9e0b72cf-4d97-b539-565a-61ce72de2709","parentId":"cace968f-3402-24a1-3b6d-6a1f2f6f84d3","programLabel":[{"type":"primary","value":"wig_tcp_pose_string:"},{"type":"secondary","value":"to_str(get_actual_tcp_pose())"}]},{"children":[],"contributedNode":{"type":"ur-assignment","version":"0.0.2","allowsChildren":false,"parameters":{"variable":{"entity":{"name":"wig_tcp_pose_string","reference":true,"type":"$$Variable","valueType":"string","declaredByID":"dd9afbde-a327-aca4-15ae-ebfd0cb1aa1b"},"selectedType":"VALUE","value":"str_sub(wig_tcp_pose_string, 1)"},"waypointType":"teach"}},"guid":"5cc3cc82-227f-d44b-6d76-5909cea51fad","parentId":"cace968f-3402-24a1-3b6d-6a1f2f6f84d3","programLabel":[{"type":"primary","value":"wig_tcp_pose_string:"},{"type":"secondary","value":"str_sub(wig_tcp_pose_string, 1)"}]}],"contributedNode":{"type":"ur-function","version":"0.0.2","allowsChildren":true,"parameters":{"isAsync":false,"function":{"name":"update_tcp_pose_string","reference":false,"type":"$$Function","declaredByID":"cace968f-3402-24a1-3b6d-6a1f2f6f84d3","id":"7ccf9544-61ea-4e8d-0c9c-d8cc48e903c6","_IDENTIFIER":"FunctionDeclaration"},"isLooping":false}},"guid":"cace968f-3402-24a1-3b6d-6a1f2f6f84d3","parentId":"31f3b476-fd63-184e-2751-a050215d93e8","programLabel":[{"type":"primary","translationKey":"program-node-label.single-value","interpolateParams":{"value":"update_tcp_pose_string"}}]},{"children":[{"children":[],"contributedNode":{"type":"ur-script","version":"0.0.1","parameters":{"name":"parse pose and write to g_object_pose","expression":"# Find the value separators\n# parameters of str_find(src, target, start_from=0)\ncomma_x = str_find(wig_camera_reply, \",\", 0)\ncomma_y = str_find(wig_camera_reply, \",\", comma_x + 1)\ncomma_z = str_find(wig_camera_reply, \",\", comma_y + 1)\ncomma_rx = str_find(wig_camera_reply, \",\", comma_z +1)\ncomma_ry = str_find(wig_camera_reply, \",\", comma_rx + 1)\n\n# Extract the values as string\n# parameters of str_sub(src,index,len)\n# -1 at the end to not get the comma itself\nx_str = str_sub(wig_camera_reply,   1,              comma_x -1)\ny_str = str_sub(wig_camera_reply,   comma_x + 1,    comma_y - comma_x - 1)\nz_str = str_sub(wig_camera_reply,   comma_y + 1,    comma_z - comma_y -1)\nrx_str = str_sub(wig_camera_reply,  comma_z + 1,    comma_rx - comma_z -1)\nry_str = str_sub(wig_camera_reply,  comma_rx + 1,   comma_ry - comma_rx -1)\n# first -1 to not get the closing paranthesis and the second to not get the comma\nrz_str = str_sub(wig_camera_reply,  comma_ry + 1,   str_len(wig_camera_reply) -1 - comma_ry -1)\n\n# Convert to numbers\nx = to_num(x_str)\ny = to_num(y_str)\nz = to_num(z_str)\nrx = to_num(rx_str)\nry = to_num(ry_str)\nrz = to_num(rz_str)\n\nwg_object_pose = p[x, y, z, rx, ry, rz]","valid":true}},"guid":"7ce9629d-057b-8f84-06e3-d3c56b4d6670","parentId":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","programLabel":"# Find the value separators"}],"contributedNode":{"type":"ur-function","version":"0.0.2","allowsChildren":true,"parameters":{"isAsync":false,"function":{"name":"string_to_pose","reference":false,"type":"$$Function","declaredByID":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","id":"c2d4d363-eb31-3c29-5799-d0eb0af2de78","_IDENTIFIER":"FunctionDeclaration"},"isLooping":false}},"guid":"bcd21bb8-3dcf-da5b-ead5-890b55c60559","parentId":"31f3b476-fd63-184e-2751-a050215d93e8","programLabel":[{"type":"primary","translationKey":"program-node-label.single-value","interpolateParams":{"value":"string_to_pose"}}]},{"children":[{"children":[],"contributedNode":{"type":"ur-call-function","version":"0.0.2","allowsChildren":false,"parameters":{"selectedModule":{"name":"wenglor_api","reference":true,"type":"$$